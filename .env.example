# App publisher/developer configuration: copy to .env.local and restart Expo.
# End users connect in Settings > Calendar Connections; they never create OAuth projects.
# Configure these same public IDs in the release build/export environment.
# Local integrations are optional; leaving both cloud values empty preserves local-only use.
# EAS builds require Cloud Sync configuration; see docs/cloud/ANDROID_CLOUD_SYNC.md.
# These are public client credentials. Never use a service_role/secret key.
# Use the project URL and sb_publishable_... key (or legacy anon JWT).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Calendar foundation: optional manual harness; false/absent is safe local-only mode.
# This is sample JSON testing, NOT Google OAuth. Restart/export after changing.
EXPO_PUBLIC_CALENDAR_MANUAL_PROVIDER=false
# Live Google Calendar OAuth. Public client IDs only; NEVER put secrets/tokens here.
# Web: authorize the exact JavaScript origin (including port) in Google Cloud.
# Android: register package com.crowleymh.LifeCommand and signing SHA-1.
# Android client ID gates configuration; native SDK resolves it by package/SHA-1.
# iOS: register bundle com.crowleymh.LifeCommand; app.config.ts derives its URL scheme.
# Rebuild native apps after configuration. Google Sign-In needs a development build.
# Web tokens stay in memory: use Reconnect after reload/expiry.
# Native calendar access tokens use Expo SecureStore; rebuild after adding the plugin.
# No client secrets or refresh tokens. Account/token data never enters JSON exports.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Microsoft Outlook: public Entra application ID; no client secret or refresh token.
# Authorization code + S256 PKCE. The lifecommand scheme is set in app.json.
# Register the web URI as Single-page application (SPA), not Web/server.
# Must match this app's exact origin and /oauth/microsoft route (no trailing slash).
# Register lifecommand://oauth/microsoft as a Mobile and desktop redirect for native.
# common supports work/school and personal accounts if the app registration allows both.
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_TENANT=common
EXPO_PUBLIC_MICROSOFT_WEB_REDIRECT_URI=
